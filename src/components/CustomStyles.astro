---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Modern Craftsman Color Palette */
  --aw-color-primary: rgb(64 70 48);
  --aw-color-secondary: rgb(128 82 58);
  --aw-color-accent: rgb(158 122 84);

  --aw-color-text-heading: rgb(26 24 20);
  --aw-color-text-default: rgb(43 39 34);
  --aw-color-text-muted: rgb(43 39 34 / 66%);
  --aw-color-bg-page: rgb(242 236 225);

  --aw-color-bg-page-dark: rgb(22 27 22);

    ::selection {
      background-color: rgb(217 199 175);      /* Warm Tan */
      color: rgb(44 56 68);
    }
  }
</style>
